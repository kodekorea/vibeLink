{
  "name": "vibelink-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VibeLink desktop tray app (spawns hub/ as a child process)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.shain.vibelink",
    "productName": "VibeLink",
    "directories": {
      "output": "dist-new"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "tray.png",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../hub",
        "to": "hub",
        "filter": [
          "src/**/*",
          "pwa/**/*",
          "package.json",
          "node_modules/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VibeLink"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
