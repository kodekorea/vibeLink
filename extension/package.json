{
  "name": "mobile-term-bridge",
  "displayName": "Mobile Terminal Bridge",
  "description": "Mirror VS Code terminal & editor to your phone in real-time",
  "version": "0.1.0",
  "publisher": "mtb",
  "engines": {
    "vscode": "^1.93.0"
  },
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "mobile",
    "remote",
    "mirror",
    "PWA"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtb/mobile-term-bridge"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mtb.start",
        "title": "MTB: Start Server"
      },
      {
        "command": "mtb.stop",
        "title": "MTB: Stop Server"
      },
      {
        "command": "mtb.showQR",
        "title": "MTB: Show QR Code"
      },
      {
        "command": "mtb.ptyTest",
        "title": "MTB: PTY Test (진단)"
      }
    ],
    "configuration": {
      "title": "Mobile Terminal Bridge",
      "properties": {
        "mtb.password": {
          "type": "string",
          "default": "",
          "markdownDescription": "페어링 암호 (휴대폰 PWA에서 입력)"
        },
        "mtb.port": {
          "type": "number",
          "default": 47800,
          "description": "로컬 서버 포트"
        },
        "mtb.tunnel": {
          "type": "string",
          "enum": [
            "temp",
            "named",
            "none"
          ],
          "enumDescriptions": [
            "임시 URL — 계정 불필요, 재시작마다 URL 변경",
            "고정 URL — Cloudflare 계정 + 도메인 필요",
            "터널 없음 — LAN 직접 접속"
          ],
          "default": "temp"
        },
        "mtb.tunnelName": {
          "type": "string",
          "default": "",
          "description": "cloudflared tunnel 이름 (named 모드 전용)"
        },
        "mtb.tunnelUrl": {
          "type": "string",
          "default": "",
          "description": "고정 URL (named 모드 전용, 예: https://my.example.com)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.5.10",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.3",
    "ws": "^8.17.0"
  }
}
